# travel hub — 설정 예시(비밀값 없음)
#
# 쓰는 법(내 PC 테스트):
#   1) 이 파일을 복사해 같은 폴더에 local.env 라는 이름으로 저장한다.
#   2) 필요한 줄의 = 뒤에 값을 직접 넣는다. 비워 두면 그 기능은 테스트(가짜) 모드로 돈다.
#   3) start-windows.cmd(또는 node scripts/start-local.mjs)로 켠다.
# local.env는 저장소·ZIP에 절대 들어가지 않는다(.gitignore). 키를 대화창·메일에 붙여 넣지 않는다.
# 실제 키를 넣으면 그 서비스에 실제 요청이 나가고 비용이 생길 수 있다(docs/OPERATIONS_SETUP.md 0절의 순서·한도 참고).

# ── 기본(내 PC 테스트용 기본값은 start-local.mjs가 채움) ──────────────
# APP_ENV=development          # production은 운영 서버에서만(이 PC 스크립트는 거부함)
# PORT=8787
# HOST=127.0.0.1               # 같은 와이파이의 폰에서 보려면 0.0.0.0 (인터넷 공개 금지)
# DB_PATH=                     # 비우면 사용자 폴더\travelhub\travelhub.db
# SERVE_STATIC=true            # 화면+API를 한 주소로("/" → 새 앱)

# ── ① Google 로그인(권장 첫 단계, 비용 없음) ─────────────────────────
# Google Cloud 콘솔 > OAuth 클라이언트 ID(웹). "승인된 JavaScript 원본"에 http://localhost:8787 추가.
GOOGLE_CLIENT_ID=

# ── ② 이메일 로그인 코드(Resend, 선택 — Google 로그인만 써도 됨) ───────
EMAIL_API_KEY=
# EMAIL_FROM=travel hub <onboarding@resend.dev>

# ── ③ 장소 위치 확인 / 영업시간(Google Places API New) — 비용 발생 가능 ──
GOOGLE_PLACES_API_KEY=
# 영업시간은 제공량이 확정되기 전까지 기본 꺼짐. 켜려면 위 키와 함께:
# BUSINESS_HOURS_ENABLE_REAL=true
# 단가 확인 후 바꿀 값(미확인 — 코드 기본은 보수적으로 $35):
# COST_PLACES_DETAILS_ENTERPRISE_USD_PER_1000=35

# ── ④ 경로 계산(Google Routes API) — 비용 발생 가능 ─────────────────
GOOGLE_ROUTES_API_KEY=

# ── ⑤ 결제(토스페이먼츠 "테스트" 키로만 먼저) ────────────────────────
TOSS_CLIENT_KEY=
PAYMENT_PG_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ── ⑥ 날씨(WeatherAPI.com 무료 등급, 선택) ───────────────────────────
WEATHER_API_KEY=

# ── 관리자 화면(/design/admin.html) 비밀번호 역할 — 길고 추측 어려운 값 ─
ADMIN_TOKEN=

# ── 운영 예산(지금 값 그대로면 비워 둠 — 바꾸는 건 docs/BUSINESS_DECISIONS.md 0-5 결정 후) ─
# COST_GLOBAL_MONTHLY_KRW_MICROS=27000000000    # 27,000원
# COST_GLOBAL_DAILY_KRW_MICROS=3000000000       # 3,000원

# ── AI 자동분류(기본 꺼짐, 켜지 않는다) ─────────────────────────────
# AI_CLASSIFY_ENABLE_REAL=
# ANTHROPIC_API_KEY=
