{
  "name": "travel-hub-app",
  "version": "1.0.0",
  "private": true,
  "description": "여행 통합 허브 앱 — 구글맵 저장목록을 동선으로 바꾸고 현지 언어까지 함께 다루는 단일 HTML 웹앱",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "build": "node scripts/build-sales.mjs",
    "test": "node scripts/test/run-all.mjs",
    "check": "npm run build && npm run verify && npm run test",
    "preview": "node scripts/serve.mjs",
    "audit": "node scripts/audit.mjs",
    "design-check": "node scripts/design-integration-check.mjs",
    "storage-migration-check": "node scripts/test-storage-migration.mjs",
    "font-coverage-check": "node scripts/test-font-coverage.mjs",
    "zip-import-check": "node scripts/test-zip-import.mjs",
    "course-check": "node scripts/test-course-generation.mjs",
    "server": "node server/index.mjs",
    "server-test": "node server/test/server.test.mjs",
    "server-config-test": "node server/test/config.test.mjs",
    "server-v2-test": "node server/test/server-v2.test.mjs",
    "server-production-boot-test": "node server/test/production-boot.test.mjs",
    "server-provider-contracts-test": "node server/test/provider-contracts.test.mjs",
    "server-trial-charging-test": "node server/test/generation-trial-charging-success.test.mjs && node server/test/generation-trial-charging-failure.test.mjs",
    "server-reliability-cost-test": "node server/test/reliability-and-cost.test.mjs",
    "server-routes-waypoint-test": "node server/test/routes-waypoint-limits.test.mjs",
    "server-cost-budget-test": "node server/test/cost-budget-allornothing.test.mjs",
    "server-trips-visits-test": "node server/test/trips-and-visits.test.mjs",
    "server-next-trip-suggestions-test": "node server/test/next-trip-suggestions.test.mjs",
    "server-trips-visits-sync-test": "node server/test/trips-visits-sync.test.mjs",
    "purchase-flow-check": "node scripts/test-purchase-flow.mjs",
    "multi-day-check": "node scripts/test-multi-day.mjs",
    "place-lookup-check": "node scripts/test-place-lookup.mjs",
    "landing-page-check": "node scripts/test-landing-page.mjs",
    "account-sync-check": "node scripts/test-account-sync.mjs",
    "revisit-flow-check": "node scripts/test-revisit-flow.mjs",
    "sync-protection-check": "node scripts/test-sync-protection-screens.mjs",
    "consumer-flow-e2e-check": "node scripts/test-consumer-flow-e2e.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "playwright": "^1.62.1"
  }
}
